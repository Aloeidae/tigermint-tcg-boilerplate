# Copy to .env.local and adjust. All values are optional — the game runs
# with a demo deck and local defaults out of the box.

# Your TON NFT collection address(es), comma-separated — one per pack /
# booster set. Cards from every listed collection join the player's deck.
# Empty = use ALL NFTs in the connected wallet.
VITE_NFT_COLLECTION=

# How NFT cards render by default: framed (system card frame, NFT image as
# art), fullart (the NFT image IS the card — for collections whose art is a
# finished card design), or overlay (full-bleed image with the name/stats/
# text composited over it at layout-assigned positions — for plain art; tune
# the layout with the menu's dev 🎨 editor). An NFT's own "Card Style"
# attribute overrides this per card.
VITE_CARD_STYLE=framed

# TonAPI endpoint + optional API key for production traffic.
VITE_TONAPI_BASE=https://tonapi.io
VITE_TONAPI_KEY=

# WebSocket URL of the PvP server (packages/server).
VITE_SERVER_URL=ws://localhost:8081

# Telegram Mini App deep link (https://t.me/yourbot/yourapp). Only for
# shipping inside Telegram: wallets return to the Mini App after signing.
VITE_TWA_RETURN_URL=

# TonConnect manifest URL. Wallets fetch this server-side, so it must be a
# PUBLIC https URL (never localhost). Defaults to this repo's manifest on
# GitHub raw — replace with a manifest describing YOUR app when you deploy.
VITE_TONCONNECT_MANIFEST=

# Where the menu's "mint your own cards" link points. Defaults to TigerMint's
# card-set wizard (https://mint.tendytiger.lol/project/submit?template=cards)
# — preconfigured for per-card attribute manifests. Set empty to hide the link.
VITE_MINT_URL=

# TigerMint "Pull a card" panel on the menu. Set BOTH to enable: your
# collection slug(s) and an API key from https://mint.tendytiger.lol/developers
# (grant it mint access from each collection dashboard's settings tab).
# Comma-separate several slugs to offer multiple booster packs — the panel
# grows arrows to page between them. Leave empty and the panel never renders.
VITE_TIGERMINT_SLUG=
VITE_TIGERMINT_API_KEY=
VITE_TIGERMINT_API_BASE=

# Pull panel starting visibility: shown (default) or hidden. Players can
# still toggle it; their choice is remembered per browser.
VITE_PULL_PANEL=shown

# Pack manifest URL(s), comma-separated. Normally UNSET: with slugs above,
# the game auto-fetches the pack.json each card set was launched from
# (TigerMint serves it at /api/v1/collections/{slug}/pack.json) whenever no
# local public/pack/pack.json ships with the client. Set this only for a
# manifest hosted somewhere else.
VITE_PACK_MANIFEST_URL=
